# ============================================================
# 환경 설정
# ============================================================
ENV=production
# development: 개발 환경
#   - 콘솔: 컬러 출력 (가독성 좋음)
#   - 파일: app.log, error.log (2개)
# production: 운영 환경
#   - 콘솔: JSON 출력 (로그 수집 도구에 적합)
#   - 파일: app.log, error.log (2개)

# ============================================================
# 로그 레벨 (콘솔 + 파일 모두 적용)
# ============================================================
LOG_LEVEL=INFO
# DEBUG: 모든 로그 출력 (개발 중 상세 디버깅 - 권장)
#   → 콘솔과 app.log에서 모든 로그 확인 가능
# INFO: 일반 정보 이상만 (기본값, 운영 환경 권장)
#   → DEBUG 로그 무시, 환율 변경/브로드캐스트 등만 표시
# WARNING: 경고 이상만 (운영 환경 최적화)
#   → SELECTOR 오류, URL 오류 등만 표시
# ERROR: 에러만 (긴급 상황만 추적)
#   → 크롤링 실패, 시스템 오류만 표시
#
# 팁: 로컬 개발 = DEBUG, 테스트/운영 = INFO

# ============================================================
# 관리자 페이지
# ============================================================
ADMIN_PASSWORD=change_this_password_in_production

# ============================================================
# 텔레그램 (Phase 2에서 활성화)
# ============================================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================================
# 데이터베이스 (Phase 2+)
# ============================================================
# SQLite (Docker 기본값 - 필요 시 사용)
# DATABASE_URL=sqlite:////data/exchange_rates.db

# PostgreSQL (RDS 등) - psycopg3 드라이버 사용
# DATABASE_URL=postgresql+psycopg://fxi_admin:your_strong_db_password@your-rds-endpoint:5432/exchange_rates
# 참고: psycopg2 사용 시 postgresql:// (기본), psycopg3 사용 시 postgresql+psycopg://

# DB_PASSWORD=your_strong_db_password_here

# ============================================================
# SSL/TLS (Phase 1에서는 미사용)
# ============================================================
# DOMAIN=your-domain.com
# EMAIL=your-email@example.com

# ============================================================
# RevenueCat (Phase 3 - 서버 사이드 구독 검증)
# ============================================================
REVENUECAT_API_KEY=sk_xxx
REVENUECAT_WEBHOOK_AUTH_KEY=your_webhook_auth_key_here

# ============================================================
# Redis latest mirror (PR3-PR5, ADR-026 — broadcast Redis-first hot path)
# ============================================================
# REDIS_LATEST_ENABLED=true 시 매 broadcast가 latest:* 키를 MGET으로 읽어
# DB 부하를 0%로 떨어뜨림. false면 기존 DB 직접 SELECT 경로 fallback.
REDIS_LATEST_ENABLED=false
LATEST_MIRROR_INTERVAL_SECONDS=3

# ============================================================
# KIS Open API (한국투자증권) — KRX 미국달러선물 (PR6, optional)
# ============================================================
# 한국투자증권 OpenAPI 키. https://apiportal.koreainvestment.com 에서 발급.
# KRX_FUTURES_ENABLED=false인 동안에는 미설정이어도 무방 (미설정 시 KRX
# bootstrap이 warning 후 격리되어 다른 서비스에는 영향 X).
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here

# KRX_FUTURES_ENABLED: KRX 미국달러선물 수집 lifecycle 토글.
# false 시 WebSocket 연결 / 신규 DB 저장 X (수집 lifecycle 자체 비활성).
# broadcast 노출은 Z-2d legacy_policy.should_include_source_in_legacy_rates
# allowlist가 단일 진실 소스 (KRX는 미포함이라 자동 차단).
# canary 1단계 진입 시 true. KRX 장애 / KIS API 점검 시 false로 변경 후
# process restart로 lifecycle 격리 (config는 import 시 1회 읽기).
KRX_FUTURES_ENABLED=false

# (KRX_BROADCAST_INCLUDE: removed in Z-2d cleanup 2026-05-12. legacy_policy
# allowlist가 단일 진실 소스 — env 토글 무의미. KRX는 allowlist 미포함이라
# broadcast latest:index에서 자동 제외. historical context는 DECISIONS.md
# ADR-027, KRX_CANARY.md 참조.)

# PR6d-1: KRX_REST_FALLBACK_ENABLED — REST snapshot/fallback 경로 토글.
# default false — PR6d 코드 배포해도 helper가 호출되지 않아 운영 영향 0.
# Stage 1에서 토글 ON 시 fallback orchestration이 stale 동안 REST 호출
# (사용자 노출은 Z-2d allowlist로 0). Stage 2 진입 전 안전 검증용.
# REST = WebSocket 대체가 아니라 stale 동안의 bounded fallback probe (ADR-027).
KRX_REST_FALLBACK_ENABLED=false

# PR6d-1: KRX_STALE_SEC — _last_tick_at 후 N초 무응답이면 stale 전이.
# 기본 60s = 코드 상수 STALE_AFTER_SEC와 동일. 5/8 baseline + raw frame metric
# (PR6d-2) 후 조정. CM 저거래량 별도 임계값 분리는 baseline 후 결정.
KRX_STALE_SEC=60

# PR6d-1: KRX_REST_COOLDOWN_SEC — REST 호출 cooldown (초).
# status 복귀 cooldown 아님 — REST 호출 중복 방지용 (stale 지속 중에는
# cooldown마다 1회). status 복귀는 frame 1건 즉시 (ADR-027 원칙).
KRX_REST_COOLDOWN_SEC=30

# KRX_CLOSE_FINALIZER_ENABLED: KRX_CLOSE_SNAPSHOT_PLAN.md §5 2차 작업 토글
# (Stage 1-5, c2fb796 deploy 2026-05-17).
# Default true — WS-first close finalizer + REST fallback 1회.
# false 시 1차 PR (c0855ff) 동작 rollback.
# 정정 명령 + 운영 절차는 KRX_CANARY.md "Rollback B" 참조.
KRX_CLOSE_FINALIZER_ENABLED=true

# KRX_CLOSE_EVENT_LOG_ENABLED: KRX close finalizer structured event 저장 토글
# (2026-05-26). Default true — Redis ZSET `krx:close_finalizer_events`에 emit
# point 10가지 event_type append-only 저장. 14d ZREMRANGEBYSCORE retention.
# admin endpoint `/admin/api/krx-finalizer-stats`에서 (date, session) 단위
# case 분류 query.
# 설계: best-effort / no-throw — Redis 장애가 close finalizer 영향 0.
# Rollback: false 설정 후 force-recreate. emit 자체 skip, 기존 event는 14d 자연 expire.
KRX_CLOSE_EVENT_LOG_ENABLED=true
