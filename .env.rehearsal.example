# Local-only W canary rehearsal. These values are not production secrets.
ENV=development
LOG_LEVEL=INFO
ADMIN_PASSWORD=local-rehearsal-admin

DATABASE_URL=sqlite:////data/exchange_rates.db
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=local-rehearsal-redis
REDIS_LATEST_ENABLED=false

# Do not read the mounted real credential during the token-free rehearsal.
FIREBASE_CREDENTIALS_PATH=/tmp/no-firebase-credentials.json
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH_KEY=

TELEGRAM_ENABLED=false
KRX_FUTURES_ENABLED=false
KRX_CLIENT_DISTRIBUTION_ENABLED=false
TOPIC_DISPATCHER_ENABLED=false
DEFAULT_EXECUTOR_PROBE_ENABLED=false
DEFAULT_EXECUTOR_PROBE_INTERVAL_SECONDS=1
WS_AUTH_EXECUTOR_LOG_TIMINGS=false
